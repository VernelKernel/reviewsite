# Local PostgreSQL from docker compose.
# The host port is 55432 because many Windows machines already use 5432.
# docker compose up -d
# npx prisma migrate dev
# npx prisma db seed
# npm run dev
DATABASE_URL="postgresql://frame:frame@127.0.0.1:55432/frame"

# Gemini. Used to read Steam review prose into an imported evaluation.
# Create a key for this project in Google AI Studio. Leave blank until then.
GEMINI_API_KEY=""

# Default visual mood. One of:
# core | editorial-observatory | cinematic-archive | modern-cultural-index | game-native
NEXT_PUBLIC_DEFAULT_MOOD="core"
NEXT_PUBLIC_DEFAULT_MODE="light"
